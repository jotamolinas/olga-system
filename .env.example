# ==========================================
# O.L.G.A. - Plantilla de Variables de Entorno
# Copia este archivo como .env para desarrollo local:
# cp .env.example .env
#
# NOTA DE SEGURIDAD:
# Nunca agregues valores reales en este archivo (.env.example).
# El archivo .env está protegido por .gitignore y nunca debe subirse a Git.
# ==========================================

# Clave de API de Gemini (Backend / Asistente Legal)
GEMINI_API_KEY=

# UID de Administrador Maestro para O.L.G.A. (opcional)
VITE_ADMIN_UID=

# Configuración Firebase Web Client (Opcional, puede sobreescribir la configuración por defecto)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
